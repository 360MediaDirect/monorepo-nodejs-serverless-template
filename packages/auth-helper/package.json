{
  "name": "@360mediadirect/auth-helper",
  "version": "1.0.0",
  "description": "JWT authentication utilities for creating and verifying tokens using EC256 keys stored in AWS SSM Parameter Store.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.x"
  },
  "scripts": {
    "prepublish": "npm run build",
    "build": "tsc",
    "clean": "rm -rf coverage dist"
  },
  "files": [
    "./dist/*"
  ],
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix --resolve-plugins-relative-to ."
    ],
    "*.{md,json}": [
      "prettier -l --write"
    ]
  },
  "dependencies": {
    "@360mediadirect/embassy": "^2.0.5",
    "@aws-sdk/client-ssm": "^3.1002.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "typescript": "^5.9.3"
  }
}
