{
  "name": "@360mediadirect/modeler",
  "version": "1.0.0",
  "description": "Lightweight DynamoDB ORM with a BaseModel class providing CRUD operations, auto-generated IDs, soft deletes, and model metadata registration.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.x"
  },
  "scripts": {
    "prepublish": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint './src/**/*.{js,ts}'",
    "lint:fix": "eslint './src/**/*.{js,ts}' --fix",
    "lint-staged": "lint-staged",
    "test": "yarn lint && jest --coverage",
    "test:watch": "yarn lint && jest --watchAll",
    "clean": "rm -rf coverage dist"
  },
  "files": [
    "./dist/*"
  ],
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix --resolve-plugins-relative-to ."
    ],
    "*.{md,json}": [
      "prettier -l --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1002.0",
    "@aws-sdk/lib-dynamodb": "^3.1002.0",
    "@aws-sdk/util-dynamodb": "^3.996.1",
    "lodash": "^4.17.23"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.4",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4",
    "@types/node": "^25.3.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.2.0",
    "jest-util": "^30.2.0",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testMatch": [
      "**/__tests__/**/*.spec.{js,ts}?(x)"
    ],
    "testEnvironment": "node",
    "verbose": true,
    "testPathIgnorePatterns": [],
    "collectCoverageFrom": [
      "src/**/*.ts"
    ]
  }
}
